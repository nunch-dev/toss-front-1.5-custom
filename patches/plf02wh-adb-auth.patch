--- a/device/phh/treble/base.mk
+++ b/device/phh/treble/base.mk
@@ -39,10 +39,13 @@
 	ro.build.version.all_codenames=$(PLATFORM_VERSION_ALL_CODENAMES) \
 	ro.build.version.release=$(PLATFORM_VERSION) \
 	ro.build.version.security_patch=$(PLATFORM_SECURITY_PATCH) \
-	ro.adb.secure=0 \
 	ro.logd.auditd=true \
 	ro.logd.kernel=true \
 
+ifneq ($(TARGET_PRODUCT),lineage_arm64_bgN)
+PRODUCT_SYSTEM_DEFAULT_PROPERTIES += ro.adb.secure=0
+endif
+
 #Huawei HiSuite (also other OEM custom programs I guess) it's of no use in AOSP builds
 PRODUCT_SYSTEM_DEFAULT_PROPERTIES += \
 	persist.sys.usb.config=adb \
--- a/device/phh/treble/system.prop
+++ b/device/phh/treble/system.prop
@@ -1,4 +1,3 @@
-ro.adb.secure=0
 #Some devices have sdcardfs kernel panicing on 8.0
 #Disable for everyone for the moment
 ro.sys.sdcardfs=0
--- a/vendor/lineage/config/common.mk
+++ b/vendor/lineage/config/common.mk
@@ -17,6 +17,9 @@
 # Disable ADB authentication
 PRODUCT_SYSTEM_DEFAULT_PROPERTIES += ro.adb.secure=0
 else
+ifeq ($(TARGET_PRODUCT),lineage_arm64_bgN)
+PRODUCT_SYSTEM_DEFAULT_PROPERTIES += ro.adb.secure=1
+else
 ifdef WITH_ADB_INSECURE
 # Forcebly disable ADB authentication
 PRODUCT_SYSTEM_DEFAULT_PROPERTIES += ro.adb.secure=0
@@ -24,6 +27,7 @@
 # Enable ADB authentication
 PRODUCT_SYSTEM_DEFAULT_PROPERTIES += ro.adb.secure=1
 endif
+endif
 
 # Disable extra StrictMode features on all non-engineering builds
 PRODUCT_SYSTEM_DEFAULT_PROPERTIES += persist.sys.strictmode.disable=true
